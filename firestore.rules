rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔓 User profiles (publicly readable, user-owned writable)
    match /users/{userId} {
      // Any signed-in user can read all user profiles (for leaderboard, etc.)
      allow read: if request.auth != null;

      // Only the user can create/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // 🔐 Nested collections — user-only access
      match /reading/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId || request.auth.uid == likerId);
          allow write: if request.auth != null && request.auth.uid == likerId;
        }
      }

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /nudges/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /friendRequestsSent/{toUid} {
        // Only the sender can add or remove sent requests
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Prevent modifications
        allow update: if false;
      }

      match /friendRequestsReceived/{fromUid} {
        // Sender can create an incoming friend request on the receiver’s node
        allow create: if request.auth != null && request.auth.uid == fromUid;
        // Receiver can list and get their incoming requests
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow sender or receiver to delete (cancel or decline)
        allow delete: if request.auth != null && (request.auth.uid == fromUid || request.auth.uid == userId);
        // Prevent updates to existing requests
        allow update: if false;
      }

      match /summary/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /readLog/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 🌐 Public reading feed
    match /read_logs/{date} {
      allow read: if request.auth != null;

      match /entries/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == likerId;
        }
      }
    }
  }
}
