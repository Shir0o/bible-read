rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 App Check error logs — allow authenticated writes only
    match /app_check_errors/{docId} {
      allow write: if request.auth != null;
      allow read: if false; // no public reads
    }

    // 🔓 User profiles (publicly readable, user-owned writable)
    match /users/{userId} {
      // Any signed-in user can read all user profiles (for leaderboard, etc.)
      allow read: if request.auth != null;

      // Only the user can create/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // 🔐 Nested collections — user-only access
      match /reading/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId || request.auth.uid == likerId);
          allow write: if request.auth != null && request.auth.uid == likerId;
        }
      }

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /nudges/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notificationPrefs/{type} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{noteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null &&
            request.auth.uid == userId;
      }

      match /friendRequestsSent/{toUid} {
        // Only the sender can add, update or remove sent requests
        allow create: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['timestamp']);
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['timestamp']);
      }

      match /friendRequestsReceived/{fromUid} {
        // Sender can create or update an incoming friend request on the receiver’s node
        allow create: if request.auth != null &&
          request.auth.uid == fromUid &&
          request.resource.data.keys().hasOnly(['timestamp', 'name']);
        // Receiver can list and get their incoming requests
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow sender or receiver to delete (cancel or decline)
        allow delete: if request.auth != null &&
          (request.auth.uid == fromUid || request.auth.uid == userId);
        allow update: if request.auth != null &&
          request.auth.uid == fromUid &&
          request.resource.data.keys().hasOnly(['timestamp', 'name']);
      }

      match /summary/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

    }

    // 👥 Groups
    match /groups/{groupId} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }

      function isOwner() {
        return request.auth != null && (
          resource.data.ownerUid == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid
        );
      }

      allow read: if isMember();
      allow write: if isOwner();

      match /members/{uid} {
        allow read: if isMember();
        allow create: if request.auth.uid == uid || isOwner();
        allow delete: if request.auth.uid == uid || isOwner();
        allow update: if isOwner();
      }

      match /schedule/{date} {
        allow read: if isMember();
        allow write: if isOwner();
      }
    }

    // 🌐 Public reading feed
    match /read_logs/{date} {
      allow read: if request.auth != null;

      match /entries/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == likerId;
        }

        // 💬 Comments on a reading entry
        match /comments/{commentId} {
          // Any signed-in user can read comments
          allow read: if request.auth != null;

          // Comment author may create using their own UID
          allow create: if request.auth != null &&
            request.auth.uid == request.resource.data.uid;

          // Allow delete by comment author or entry owner
          allow delete: if request.auth != null &&
            (request.auth.uid == resource.data.uid || request.auth.uid == userId);

          // Prevent updates to existing comments
          allow update: if false;
        }
      }
    }
  }
}
