rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔓 User profiles (publicly readable, user-owned writable)
    match /users/{userId} {
      // Any signed-in user can read all user profiles (for leaderboard, etc.)
      allow read: if request.auth != null;

      // Only the user can create/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // 🔐 Nested collections — user-only access
      match /reading/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read, write: if request.auth != null && request.auth.uid == likerId;
        }
      }

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /friendRequestsSent/{toUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /friendRequestsReceived/{fromUid} {
        allow write: if request.auth != null && request.auth.uid == fromUid;
        allow read: if request.auth != null && request.auth.uid == userId;
      }

      match /summary/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /readLog/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 🌐 Public reading feed
    match /read_logs/{date} {
      allow read: if request.auth != null;

      match /entries/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == likerId;
        }
      }
    }
  }
}
