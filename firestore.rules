rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

  function isStringOrNull(value) {
    return value == null || value is string;
  }

  function isTruthy(value) {
    return value == true || value == 'true' || value == 1 || value == '1';
  }

  function isAdmin() {
    return request.auth != null && (
      isTruthy(request.auth.token.admin) ||
      isTruthy(request.auth.token.isAdmin) ||
      (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          isTruthy(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin) ||
          isTruthy(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin) ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string &&
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
            )
          ) ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is map &&
            (
              isTruthy(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.admin) ||
              isTruthy(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.isAdmin)
            )
          )
        )
      )
    );
  }

  function isValidFeedbackCreate() {
      return request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'title',
            'description',
            'reproductionSteps',
            'platform',
            'timestamp',
            'status',
            'updatedAt',
            'resolvedAt',
            'resolutionNotes',
          ]) &&
          request.resource.data.keys().hasAll([
            'title',
            'description',
            'platform',
            'timestamp',
            'status',
            'updatedAt',
          ]) &&
          request.resource.data.title is string &&
          request.resource.data.description is string &&
          request.resource.data.platform is string &&
          request.resource.data.timestamp is timestamp &&
          request.resource.data.updatedAt is timestamp &&
          request.resource.data.status is string &&
          request.resource.data.status == 'open' &&
          request.resource.data.updatedAt == request.resource.data.timestamp &&
          isStringOrNull(request.resource.data.uid) &&
          isStringOrNull(request.resource.data.email) &&
          isStringOrNull(request.resource.data.displayName) &&
          isStringOrNull(request.resource.data.reproductionSteps) &&
          request.resource.data.resolvedAt == null &&
          request.resource.data.resolutionNotes == null;
    }

    // 🔐 App Check error logs — allow authenticated writes only
    match /app_check_errors/{docId} {
      allow write: if request.auth != null;
      allow read: if false; // no public reads
    }

    // 🔓 User profiles (publicly readable, user-owned writable)
    match /users/{userId} {
      // Any signed-in user can read all user profiles (for leaderboard, etc.)
      allow read: if request.auth != null;

      // Only the user can create/update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // 🔐 Nested collections — user-only access
      match /seasonChallenges/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          ((request.resource.data.progress == true ||
              request.resource.data.progress == false ||
              request.resource.data.progress == null) &&
            (request.resource.data.claimed == true ||
              request.resource.data.claimed == false ||
              request.resource.data.claimed == null));
      }

      match /seasonRewards/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /exerciseChallenges/{challengeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /exerciseProgress/{dayKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /reading/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId || request.auth.uid == likerId);
          allow write: if request.auth != null && request.auth.uid == likerId;
        }
      }

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /nudges/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notificationPrefs/{type} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{noteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null &&
            request.auth.uid == userId;
      }

      match /friendRequestsSent/{toUid} {
        // Only the sender can add, update or remove sent requests
        allow create: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['timestamp']);
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['timestamp']);
      }

      match /friendRequestsReceived/{fromUid} {
        // Sender can create or update an incoming friend request on the receiver’s node
        allow create: if request.auth != null &&
          request.auth.uid == fromUid &&
          request.resource.data.keys().hasOnly(['timestamp', 'name']);
        // Receiver can list and get their incoming requests
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow sender or receiver to delete (cancel or decline)
        allow delete: if request.auth != null &&
          (request.auth.uid == fromUid || request.auth.uid == userId);
        allow update: if request.auth != null &&
          request.auth.uid == fromUid &&
          request.resource.data.keys().hasOnly(['timestamp', 'name']);
      }

      match /friendStreakInvites/{partnerUid} {
        function isOwnerOrPartner() {
          return request.auth != null &&
            (request.auth.uid == userId || request.auth.uid == partnerUid);
        }

        allow read: if isOwnerOrPartner();
        allow create, update: if isOwnerOrPartner() &&
          request.resource.data.keys().hasOnly([
            'partnerUid',
            'partnerName',
            'initiatedBy',
            'status',
            'currentStreak',
            'lastUserCovered',
            'lastPartnerCovered',
            'createdAt',
            'updatedAt',
          ]) &&
          (!request.resource.data.keys().hasAny(['partnerUid']) ||
            request.resource.data.partnerUid == partnerUid);
        allow delete: if isOwnerOrPartner();
      }

      match /friendStreakLinks/{partnerUid} {
        function isOwnerOrPartner() {
          return request.auth != null &&
            (request.auth.uid == userId || request.auth.uid == partnerUid);
        }

        function isOwnerOrFriend() {
          return request.auth != null &&
            (request.auth.uid == userId ||
              exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
        }

        allow read: if isOwnerOrFriend();
        allow create, update: if isOwnerOrPartner() &&
          request.resource.data.keys().hasOnly([
            'partnerUid',
            'partnerName',
            'initiatedBy',
            'status',
            'currentStreak',
            'lastUserCovered',
            'lastPartnerCovered',
            'createdAt',
            'updatedAt',
          ]) &&
          (!request.resource.data.keys().hasAny(['partnerUid']) ||
            request.resource.data.partnerUid == partnerUid);
        allow delete: if isOwnerOrPartner();
      }

      match /summary/{docId} {
        // Public leaderboard reads summary/data for all users; other summary
        // documents remain private to the owner.
        allow read: if request.auth != null && (request.auth.uid == userId || docId == 'data');
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /cache/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

    }

    // 👥 Groups
    match /groups/{groupId} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }

      function isOwner() {
        return request.auth != null &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
      }

      function isOwnerOrAdmin() {
        return isOwner() || (
          request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
        );
      }

      allow read: if request.auth != null;
      // Allow any signed-in user to create a new group document.
      allow create: if request.auth != null;
      // Restrict modifications and deletes to owner/admins of existing groups.
      allow update: if isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();

      match /members/{uid} {
        allow read: if request.auth != null;
        // Owner can create their own member record at group creation.
        // Admin/owner can create a member when approving a join request.
        allow create: if (
            (isOwner() && request.auth != null && request.auth.uid == uid)
          ) || (
            isOwnerOrAdmin() &&
            exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(uid)) &&
            !existsAfter(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(uid))
          );
        allow delete: if isOwnerOrAdmin();
        allow update: if isOwnerOrAdmin() || (
          request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid
        );
      }

      match /schedule/{date} {
        allow read: if request.auth != null;
        allow write: if isOwnerOrAdmin();
      }

      // Per-group progress: members can mark their own completion for a date.
      match /progress/{dateId} {
        // Allow owner/admin to read progress for management; members can read too.
        allow read: if isMember() || isOwnerOrAdmin();
        // Allow owner/admin to clean up progress documents when managing or deleting the group.
        allow delete: if isOwnerOrAdmin();

        match /entries/{uid} {
          // Allow owner/admin to read entries; members can read.
          allow read: if isMember() || isOwnerOrAdmin();
          allow write: if isMember() && request.auth != null && request.auth.uid == uid;
          // Owner/admin may delete any member's progress when deleting the group or moderating.
          allow delete: if isOwnerOrAdmin() || (request.auth != null && request.auth.uid == uid);

          // Per-item completion under an entry for partial progress
          match /items/{itemId} {
            allow read: if isMember() || isOwnerOrAdmin();
            allow write: if isMember() && request.auth != null && request.auth.uid == uid;
            allow delete: if isOwnerOrAdmin() || (request.auth != null && request.auth.uid == uid);
          }
        }
      }

      // Cached per-member overall progress across all scheduled chapters.
      match /progressSummary/{docId} {
        allow read: if isMember() || isOwnerOrAdmin();
        allow delete: if isOwnerOrAdmin();

        match /entries/{uid} {
          allow read: if isMember() || isOwnerOrAdmin();
          allow write: if request.auth != null && request.auth.uid == uid;
          allow delete: if isOwnerOrAdmin() || (request.auth != null && request.auth.uid == uid);
        }
      }

      match /joinRequests/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        // Allow owners/admins to read all requests for their group, and allow
        // the requesting user to read their own join request (for collectionGroup queries).
        allow read: if isOwnerOrAdmin() || (request.auth != null && request.auth.uid == uid);
        allow delete: if isOwnerOrAdmin() || (request.auth != null && request.auth.uid == uid);
      }
    }

    // 🍂 Seasonal challenges
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /challenges/{challengeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // 🎁 Daily rewards
    match /daily_rewards/{dateKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 🌐 Public reading feed
    match /read_logs/{date} {
      allow read: if request.auth != null;

      match /entries/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /likes/{likerId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == likerId;
        }

        // 💬 Comments on a reading entry
        match /comments/{commentId} {
          // Any signed-in user can read comments
          allow read: if request.auth != null;

          // Comment author may create using their own UID
          allow create: if request.auth != null &&
            request.auth.uid == request.resource.data.uid;

          // Allow delete by comment author or entry owner
          allow delete: if request.auth != null &&
            (request.auth.uid == resource.data.uid || request.auth.uid == userId);

          // Prevent updates to existing comments
          allow update: if false;
        }
      }
    }

  // 🐞 Bug reports
  match /bugReports/{docId} {
    allow read: if isAdmin() || (request.auth != null &&
      resource.data.uid != null && request.auth.uid == resource.data.uid);
    allow create: if request.auth != null && isValidFeedbackCreate();
    allow update, delete: if false;
  }

  // 💡 Feature requests
  match /featureRequests/{docId} {
    allow read: if isAdmin() || (request.auth != null &&
      resource.data.uid != null && request.auth.uid == resource.data.uid);
    allow create: if request.auth != null && isValidFeedbackCreate();
    allow update, delete: if false;
  }
  }
}
