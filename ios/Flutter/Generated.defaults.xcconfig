// Fallback Flutter build settings used when Generated.xcconfig is absent.
FLUTTER_ROOT=$(SRCROOT)/../flutter
FLUTTER_APPLICATION_PATH=$(SRCROOT)/..
COCOAPODS_PARALLEL_CODE_SIGN=true
FLUTTER_TARGET=lib/main.dart
FLUTTER_BUILD_DIR=build
FLUTTER_BUILD_NAME=1.16.0
FLUTTER_BUILD_NUMBER=17
EXCLUDED_ARCHS[sdk=iphonesimulator*]=i386
EXCLUDED_ARCHS[sdk=iphoneos*]=armv7
DART_DEFINES=
DART_OBFUSCATION=false
TRACK_WIDGET_CREATION=false
TREE_SHAKE_ICONS=true
PACKAGE_CONFIG=$(FLUTTER_APPLICATION_PATH)/.dart_tool/package_config.json
